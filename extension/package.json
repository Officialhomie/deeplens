{
  "name": "deeplens-extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && vite build --config vite.content.config.ts && node scripts/finalize-manifest.mjs",
    "test": "vitest run && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "measure": "node scripts/measure-bundles.mjs",
    "prezip": "npm run typecheck && npm run test:unit && npm run build",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "zip": "node scripts/zip.js",
    "icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.0.0-beta.28",
    "@playwright/test": "^1.49.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.0.287",
    "@types/dompurify": "^3.0.5",
    "archiver": "^8.0.0",
    "happy-dom": "^15.11.7",
    "pngjs": "^7.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "dompurify": "^3.4.5"
  }
}
